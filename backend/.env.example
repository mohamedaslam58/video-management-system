NODE_ENV=development
PORT=3000

# Postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=vms
DB_PASSWORD=change_me
DB_NAME=vms

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Camera credential encryption (32-byte key, base64)
CAMERA_SECRET_KEY=change_me_32_byte_base64_key==

# MediaMTX control API
MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_HLS_BASE_URL=http://localhost:8888
MEDIAMTX_WEBRTC_BASE_URL=http://localhost:8889

# MinIO / S3
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=vms_minio
S3_SECRET_KEY=change_me_minio_secret
S3_BUCKET=vms-recordings
S3_REGION=us-east-1

# Retention
DEFAULT_RETENTION_DAYS=30
